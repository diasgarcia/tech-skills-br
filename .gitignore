__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Testes e ferramentas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Banco gerado a partir dos CSVs (reconstruivel, nao versionar)
data/
*.db
*.sqlite3

